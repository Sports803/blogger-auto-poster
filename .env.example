BLOGGER_RSS=https://yourblog.blogspot.com/feeds/posts/default
TELEGRAM_BOT_TOKEN=xxx
TELEGRAM_CHAT_ID=xxx
BUFFER_API_KEY=xxx
# Comma-separated Buffer channel IDs; Twitter/Facebook are text-compatible.
BUFFER_CHANNEL_IDS=6a7fd0dab2d9d577437e1234,6a7fd04db2d9d577437e1095
BUFFER_MODE=addToQueue
# Required only for BUFFER_MODE=customScheduled; use a future ISO-8601 timestamp.
BUFFER_DUE_AT=
BUFFER_API_URL=https://api.buffer.com
MAX_ITEMS_PER_RUN=15
DRY_RUN=false
